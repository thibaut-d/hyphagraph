algiagraph.com {
    handle /api/* {
        reverse_proxy api:8000
    }

    handle {
        @html {
            not path *.js *.css *.png *.svg *.ico *.woff2 *.woff *.ttf
        }
        header @html Cache-Control "no-store, no-cache, must-revalidate"
        reverse_proxy web:3000
    }
}

# Sites hébergés à côté de hyphagraph (un fichier par site, monté en lecture seule)
import /etc/caddy/sites/*.caddy
